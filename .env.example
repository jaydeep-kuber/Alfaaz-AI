# ==============================================================================
# Alfaaz Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT commit .env or any secret values into source control.
# Note on host vs container networking:
# - Running on host directly: DATABASE_URL uses localhost:5432, SMTP_HOST uses localhost.
# - Running inside Docker Compose: DATABASE_URL uses db:5432, SMTP_HOST uses mailpit.
# ==============================================================================

# Database Connection (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database>
# Host value:      postgresql://alfaaz:alfaaz123@localhost:5432/alfaaz_dev
# Container value: postgresql://alfaaz:alfaaz123@db:5432/alfaaz_dev
DATABASE_URL=

# Better Auth Secret Key
# Cryptographically secure random key used to sign session cookies and tokens.
# Generate locally using: openssl rand -base64 32
AUTH_SECRET=

# Application Base URL
# Base URL where the web application is accessible.
# Used for authentication callbacks, redirects, and self-referential links.
# Local development default: http://localhost:3000
BASE_URL=

# SMTP Server Hostname
# Host value:      localhost
# Container value: mailpit
SMTP_HOST=

# SMTP Server Port
# Default for Mailpit SMTP: 1025 (Standard submission port: 587 or 465 for production)
SMTP_PORT=

# SMTP Username
# Authentication credential for SMTP. Leave empty for unauthenticated local Mailpit.
SMTP_USER=

# SMTP Password
# Authentication credential for SMTP. Leave empty for unauthenticated local Mailpit.
SMTP_PASS=

# Default Sender Address
# Format: "Sender Name <email@example.com>" or "email@example.com"
# Example: "Alfaaz <noreply@alfaaz.local>"
SMTP_FROM=

# Allowed Email Domains (Comma-separated list)
# Configuration placeholder for future signup policy enforcement.
# (Not enforced in AUTH-1 scaffolding per ticket scope).
ALLOWED_EMAIL_DOMAINS=gmail.com,outlook.com,hotmail.com,yahoo.com,icloud.com
